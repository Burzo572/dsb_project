   "source": [
    "# Data Quality Check\n",
    "\n",
    "audit = test_rf[[\"target_date\", \"flood_tomorrow\"]].reset_index(drop=True).copy()\n",
    "\n",
    "audit[\"rf_prediction\"] = y_pred_depth\n",
    "\n",
    "# Last day of each chunk\n",
    "audit[\"day3\"] = audit[\"target_date\"] - pd.Timedelta(days=1)\n",
    "\n",
    "# Add environmental measurements\n",
    "sw90_check = sw90.set_index(\"date\")\n",
    "\n",
    "for col in [\n",
    "    \"rainfall_local_mm\",\n",
    "    \"rainfall_upstream_mm\",\n",
    "    \"river_discharge_m3s\"]:\n",
    "    audit[col] = audit[\"day3\"].map(sw90_check[col])\n",
    "\n",
    "# Identify disagreements\n",
    "audit[\"review_needed\"] = (\n",
    "    audit[\"flood_tomorrow\"] != audit[\"rf_prediction\"])\n",
    "\n",
    "# Additional dates identified through external reports\n",
    "dates_to_check = pd.to_datetime([\n",
    "    \"2024-07-03\",\n",
    "    \"2024-07-04\",\n",
    "    \"2024-07-05\"])\n",
    "\n",
    "audit.loc[\n",
    "    audit[\"target_date\"].isin(dates_to_check),\n",
    "    \"review_needed\"] = True\n",
    "\n",
    "# Display cases requiring review\n",
    "audit[audit[\"review_needed\"]][[\n",
    "    \"target_date\",\n",
    "    \"flood_tomorrow\",\n",
    "    \"rf_prediction\",\n",
    "    \"rainfall_local_mm\",\n",
    "    \"rainfall_upstream_mm\",\n",
    "    \"river_discharge_m3s\"]]"
   ]
  },
