   "source": [
    "# Random Forest with limited tree depth\n",
    "rf_depth = RandomForestClassifier(\n",
    "    max_depth=5,\n",
    "    random_state=42)\n",
    "\n",
    "rf_depth.fit(X_train_rf, y_train_rf)\n",
    "\n",
    "print(\"Train Accuracy:\", rf_depth.score(X_train_rf, y_train_rf))\n",
    "print(\"Test Accuracy:\", rf_depth.score(X_test_rf, y_test_rf))\n",
    "\n",
    "# Predictions\n",
    "y_pred_depth = rf_depth.predict(X_test_rf)\n",
    "\n",
    "print(\"\\nConfusion Matrix:\")\n",
    "print(confusion_matrix(y_test_rf, y_pred_depth))\n",
    "\n",
    "print(\"\\nClassification Report:\")\n",
    "print(classification_report(\n",
    "    y_test_rf,\n",
    "    y_pred_depth,\n",
    "    zero_division=0))"
   ]
