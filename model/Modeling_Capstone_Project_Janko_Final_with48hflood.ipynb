   "source": [
    "from sklearn.metrics import precision_score, recall_score, f1_score\n",
    "\n",
    "# Probabilities from Balanced Model\n",
    "probs_balanced = model2_balanced.predict_proba(\n",
    "    X_val2_scaled)[:, 1]\n",
    "\n",
    "thresholds = [0.5, 0.6, 0.7, 0.8, 0.9]\n",
    "\n",
    "for threshold in thresholds:\n",
    "\n",
    "    predictions = (probs_balanced >= threshold).astype(int)\n",
    "\n",
    "    tn, fp, fn, tp = confusion_matrix(\n",
    "        y_val2, predictions, labels=[0, 1]).ravel()\n",
    "\n",
    "    print(f\"\\nThreshold: {threshold}\")\n",
    "    print(\"Floods detected:\", tp)\n",
    "    print(\"Floods missed:\", fn)\n",
    "    print(\"False alarms:\", fp)\n",
