   "source": [
    "# Predictions for each chunk\n",
    "results = test[[\"target_date\", \"flood_tomorrow\"]].reset_index(drop=True).copy()\n",
    "\n",
    "# Days used for prediction\n",
    "results[\"day1\"] = results[\"target_date\"] - pd.Timedelta(days=3)\n",
    "results[\"day2\"] = results[\"target_date\"] - pd.Timedelta(days=2)\n",
    "results[\"day3\"] = results[\"target_date\"] - pd.Timedelta(days=1)\n",
    "\n",
    "# Model predictions\n",
    "results[\"prediction\"] = y_pred.astype(int)\n",
    "\n",
    "# Probability of flood\n",
    "results[\"probability\"] = log_model.predict_proba(X_test_scaled)[:, 1]\n",
    "\n",
    "# Display results\n",
    "results[[\n",
    "    \"day1\", \"day2\", \"day3\", \"target_date\",\n",
    "    \"flood_tomorrow\", \"prediction\", \"probability\"]].head(10)"
   ]
  },
