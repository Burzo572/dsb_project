   "source": [
    "features = [\n",
    "    \"rainfall_local_mm\",\n",
    "    \"soil_moisture_local\",\n",
    "    \"river_discharge_m3s\"]\n",
    "\n",
    "# SW90 - measurements + target\n",
    "sw90_data = sw90[\n",
    "    [\"date\", \"flood_within_24h\"] + features].copy()\n",
    "\n",
    "# SW17 - only measurements\n",
    "sw17_data = sw17[\n",
    "    [\"date\"] + features].copy()\n",
    "\n",
    "# Merge stations by date\n",
    "combined = pd.merge(\n",
    "    sw90_data,\n",
    "    sw17_data,\n",
    "    on=\"date\",\n",
    "    suffixes=(\"_sw90\", \"_sw17\"),\n",
    "    validate=\"one_to_one\")\n",
    "\n",
    "combined = combined.sort_values(\"date\").reset_index(drop=True)\n",
    "\n",
    "print(\"Shape:\", combined.shape)\n",
    "combined.head()"
   ]
