   "source": [
    "# Features from both stations\n",
    "features_combined = [\n",
    "    col for col in combined.columns\n",
    "    if col not in [\"date\", \"flood_within_24h\"]]\n",
    "\n",
    "chunks_combined = []\n",
    "\n",
    "for i in range(len(combined) - 2):\n",
    "    window = combined.iloc[i:i+3]\n",
    "\n",
    "    row = {}\n",
    "\n",
    "    for day in range(3):\n",
    "        for feature in features_combined:\n",
    "            row[f\"{feature}_day{day+1}\"] = window.iloc[day][feature]\n",
    "\n",
    "    row[\"target_date\"] = window.iloc[-1][\"date\"] + pd.Timedelta(days=1)\n",
    "    row[\"flood_tomorrow\"] = window.iloc[-1][\"flood_within_24h\"]\n",
    "\n",
    "    chunks_combined.append(row)\n",
    "\n",
    "sw90_sw17_chunks = pd.DataFrame(chunks_combined)\n",
    "\n",
    "print(\"Shape:\", sw90_sw17_chunks.shape)\n",
    "\n",
    "sw90_sw17_chunks.head()"
   ]
  },
  {
   "cell_type": "markdown",
