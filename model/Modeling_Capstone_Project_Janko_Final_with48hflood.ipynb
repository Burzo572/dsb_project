    "    \"Random Forest\": y_pred_depth}\n",
    "\n",
    "# Compare models\n",
    "comparison_results = []\n",
    "\n",
    "for name, pred in predictions.items():\n",
    "\n",
    "    tn, fp, fn, tp = confusion_matrix(\n",
    "        y_test_rf, pred, labels=[0, 1]).ravel()\n",
    "\n",
    "    comparison_results.append({\n",
    "        \"Model\": name,\n",
    "        \"Accuracy\": accuracy_score(y_test_rf, pred),\n",
    "        \"Precision\": precision_score(y_test_rf, pred, zero_division=0),\n",
    "        \"Recall\": recall_score(y_test_rf, pred, zero_division=0),\n",
    "        \"F1\": f1_score(y_test_rf, pred, zero_division=0),\n",
    "        \"Floods Detected\": tp,\n",
    "        \"False Alarms\": fp})\n",
    "\n",
    "comparison_df = pd.DataFrame(comparison_results)\n",
    "\n",
    "comparison_df.round(3)"
