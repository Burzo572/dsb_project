   "cell_type": "code",
   "source": [
    "# Compare all 48h models\n",
    "models_48h = {\"Seasonal Baseline\": baseline_48h,\"Logistic Regression\": y_pred_48h,\"Random Forest\": y_pred_rf_48h}\n",
    "\n",
    "results_48h = []\n",
    "\n",
    "for name, pred in models_48h.items():\n",
    "    results_48h.append({\n",
    "        \"Model\": name,\n",
    "        \"Accuracy\": accuracy_score(y_test_48h, pred),\n",
    "        \"Precision\": precision_score(y_test_48h, pred, zero_division=0),\n",
    "        \"Recall\": recall_score(y_test_48h, pred, zero_division=0),\n",
    "        \"F1-score\": f1_score(y_test_48h, pred, zero_division=0)})\n",
    "\n",
    "comparison_48h = pd.DataFrame(results_48h)\n",
    "\n",
    "comparison_48h.round(3)"
