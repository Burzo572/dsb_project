    "\n",
    "assert test_combined[\"target_date\"].reset_index(drop=True).equals(\n",
    "    test_rf[\"target_date\"].reset_index(drop=True))\n",
    "\n",
    "# All model predictions\n",
    "predictions = {\n",
    "    \"Seasonal Baseline\": baseline_pred,\n",
