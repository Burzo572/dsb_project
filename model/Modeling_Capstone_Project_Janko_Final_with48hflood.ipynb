  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Split the data chronologically (70% train / 30% test)\n",
    "**Purpose:** Use data through 2024, keeping earlier dates for training and later dates for testing. The final training window is excluded where its 48-hour target period could overlap the start of the test period. The model uses 18 measurements from the preceding three days.\n"
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "# Remove 2025\n",
    "data_48h = chunks_48h[chunks_48h[\"target_date\"].dt.year <= 2024].copy()\n",
    "\n",
    "# Sort chronologically\n",
    "data_48h = data_48h.sort_values(\"target_date\").reset_index(drop=True)\n",
    "\n",
    "# 70/30 split\n",
    "split_48h = int(len(data_48h) * 0.7)\n",
    "\n",
    "train_48h = data_48h.iloc[:split_48h].copy()\n",
    "test_48h = data_48h.iloc[split_48h:].copy()\n",
    "\n",
    "# Avoid overlap of 48h target periods\n",
    "first_test_date = test_48h[\"target_date\"].min()\n",
    "\n",
    "train_48h = train_48h[train_48h[\"target_date\"] + pd.Timedelta(days=1) < first_test_date].copy()\n",
    "\n",
    "# Define X and y\n",
    "X_train_48h = train_48h.drop(columns=[\"target_date\", \"flood_next_48h\"])\n",
    "\n",
    "X_test_48h = test_48h.drop(columns=[\"target_date\", \"flood_next_48h\"])\n",
    "\n",
    "y_train_48h = train_48h[\"flood_next_48h\"]\n",
    "y_test_48h = test_48h[\"flood_next_48h\"]\n",
    "\n",
    "print(\"Train:\", X_train_48h.shape)\n",
    "print(\"Test:\", X_test_48h.shape)\n",
    "\n",
    "print(\"\\nTrain floods:\")\n",
    "print(y_train_48h.value_counts())\n",
    "\n",
    "print(\"\\nTest floods:\")\n",
    "print(y_test_48h.value_counts())"
   ],
   "metadata": {
