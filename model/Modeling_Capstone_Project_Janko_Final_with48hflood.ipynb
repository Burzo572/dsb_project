    "features = [\n",
    "    \"rainfall_local_mm\",\n",
    "    \"soil_moisture_local\",\n",
    "    \"river_discharge_m3s\"]\n",
    "\n",
    "chunks = []\n",
    "\n",
    "for i in range(len(sw90) - 2):\n",
    "    window = sw90.iloc[i:i+3]\n",
    "\n",
    "    row = {}\n",
    "\n",
    "    for day in range(3):\n",
    "        for feature in features:\n",
    "            row[f\"{feature}_day{day+1}\"] = window.iloc[day][feature]\n",
    "\n",
    "    row[\"target_date\"] = window.iloc[-1][\"date\"] + pd.Timedelta(days=1)\n",
    "    row[\"flood_tomorrow\"] = window.iloc[-1][\"flood_within_24h\"]\n",
    "\n",
    "    chunks.append(row)\n",
    "\n",
    "sw90_chunks = pd.DataFrame(chunks)\n",
    "\n",
    "sw90_chunks.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "8SZeZ0ZBYmiP"
   },
   "source": [
