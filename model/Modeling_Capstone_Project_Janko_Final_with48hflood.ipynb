   "source": [
    "### Build a standalone Random Forest train/test dataset\n",
    "**Purpose:** Recreate the 70/30 chronological split and `X`/`y` variables with names dedicated to the Random Forest section. This supports presenting Random Forest as a separate modeling exercise while keeping **the same chunks, dates and target**. The underlying data are equivalent to the earlier combined-station split; we are not creating a new independent test."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "k4BTACuSLX9o",
    "outputId": "caea9bdf-82ab-4112-ad3c-ea3f41e5a4c0"
   },
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "X_train: (1020, 18)\n",
      "X_test: (438, 18)\n",
      "y_train: (1020,)\n",
      "y_test: (438,)\n"
     ]
    }
   ],
   "source": [
    "# Remove 2025\n",
    "rf_data = sw90_sw17_chunks[\n",
    "    sw90_sw17_chunks[\"target_date\"].dt.year <= 2024].copy()\n",
    "\n",
    "# Sort by date\n",
    "rf_data = rf_data.sort_values(\"target_date\").reset_index(drop=True)\n",
    "\n",
    "# 70/30 Train/Test Split\n",
    "split_rf = int(len(rf_data) * 0.7)\n",
    "\n",
    "train_rf = rf_data.iloc[:split_rf]\n",
    "test_rf = rf_data.iloc[split_rf:]\n",
    "\n",
    "# Define X and y\n",
    "X_train_rf = train_rf.drop(columns=[\"target_date\", \"flood_tomorrow\"])\n",
    "X_test_rf = test_rf.drop(columns=[\"target_date\", \"flood_tomorrow\"])\n",
    "\n",
    "y_train_rf = train_rf[\"flood_tomorrow\"]\n",
    "y_test_rf = test_rf[\"flood_tomorrow\"]\n",
    "\n",
    "print(\"X_train:\", X_train_rf.shape)\n",
    "print(\"X_test:\", X_test_rf.shape)\n",
    "print(\"y_train:\", y_train_rf.shape)\n",
    "print(\"y_test:\", y_test_rf.shape)"
   ]
  },
