   "source": [
    "# Select chunks with actual floods\n",
    "flood_idx = results.index[results[\"flood_tomorrow\"] == 1]\n",
    "\n",
    "# Features for these chunks\n",
    "flood_features = X_test.iloc[flood_idx]\n",
    "\n",
    "# Combine dates, predictions and features\n",
    "flood_analysis = pd.concat([\n",
    "    results.loc[flood_idx, [\n",
    "        \"day1\", \"day2\", \"day3\",\n",
    "        \"target_date\", \"prediction\"]].reset_index(drop=True),\n",
    "\n",
    "    flood_features.reset_index(drop=True)], axis=1)\n",
    "\n",
    "flood_analysis"
   ]
  },
